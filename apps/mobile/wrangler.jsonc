{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "glowbook-web",
  "compatibility_date": "2026-11-19",
  "build": {
    "command": "npm run build:cloudflare",
    "watch_dir": ["src", "angular.json", "package.json"]
  },
  "assets": {
    "directory": "./www",
    "not_found_handling": "single-page-application"
  }
}
